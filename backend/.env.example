# ============================================
# Fragranza Olio - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ======================
# Railway (auto-injected when MySQL service is linked)
# These are set automatically by Railway - no need to configure manually
# ======================
# MYSQLHOST=
# MYSQLDATABASE=railway
# MYSQLUSER=root
# MYSQLPASSWORD=
# MYSQLPORT=3306
# RAILWAY_ENVIRONMENT=production

# ======================
# Production Database (InfinityFree - legacy)
# ======================
PROD_DB_HOST=sql311.infinityfree.com
PROD_DB_NAME=if0_41131668_fragranza
PROD_DB_USER=if0_41131668
PROD_DB_PASS=your_production_password_here

